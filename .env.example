# ── 复制为 .env 并填写 ─────────────────────────────────────────────
# 所有配置均有默认值；未设置的行使用默认值。

# ── VLM（图片描述）可选。留空 LLM_BASE_URL/LLM_API_KEY/LLM_MODEL
#    或设 VLM_ENABLED=false 可关闭，入库时图片描述退化为空串。
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
VLM_ENABLED=true
VLM_TIMEOUT_SECONDS=30
VLM_MAX_TOKENS=512

# ── Milvus（需提前启动，见 README）───────────────────────────────
MILVUS_HOST=localhost
MILVUS_PORT=19531
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_SECURE=false
MILVUS_DB=mushroom_rag
MILVUS_TEXT_COLLECTION=mushroom_knowledge
MILVUS_IMAGE_COLLECTION=mushroom_images
WIKI_MILVUS_COLLECTION=wiki_knowledge
MILVUS_DIM=512
MILVUS_HEALTH_CHECK_INTERVAL=300

# ── Redis（Celery broker/result backend）─────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=1

# ── Wiki 域 PostgreSQL（ROADMAP P0-T6）──────────────────────────────
# 对应 docker-compose.yml 的 postgres 服务：docker compose up -d postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=wiki
POSTGRES_PASSWORD=wiki
POSTGRES_DB=wiki

# ── Wiki 用户 JWT 认证（Phase 2）────────────────────────────────────
# 生产环境务必设置强随机值：python -c "import secrets; print(secrets.token_urlsafe(48))"
# 留空则 token 相关接口返回 503（未启用）。
JWT_SECRET=
JWT_EXPIRE_MINUTES=10080

# ── 模型 ──────────────────────────────────────────────────────────
# 默认走本地模型缓存（EMBEDDER_LOCAL_FILES_ONLY=true）。
# 首次若需自动下载请设为 false。
SENTENCE_TRANSFORMERS_MODEL=BAAI/bge-small-zh-v1.5
CLIP_MODEL=OFA-Sys/chinese-clip-vit-base-patch16
EMBEDDER_LOCAL_FILES_ONLY=true

# ── 路径 ──────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
DATA_DIR=data
DB_PATH=data/pipeline.db
LOG_LEVEL=INFO

# ── 切片参数默认值 ───────────────────────────────────────────────
MAX_FILE_SIZE_MB=50
MAX_IMAGE_SIZE_MB=10
# ── MinerU 文档转换（pdf/docx/pptx，GPU）────────────────────────
# 先运行 scripts/start_mineru_api.bat 启动 mineru-api，再指向它。
# 唯一转换引擎：pdf/docx/pptx 走 MinerU（GPU）；html/md/txt 走内置轻量转换，
# 无需外部引擎。MINERU_ENABLED=false 时 pdf/docx/pptx 转换会直接报错。
MINERU_ENABLED=true
MINERU_BASE_URL=http://127.0.0.1:8010
# pipeline=快、无幻觉、4GB+显存；hybrid-engine=精度更高、需 8GB+显存
MINERU_BACKEND=pipeline
# 单次同步解析超时（秒）：必须低于 Celery task_soft_time_limit(1500s)
MINERU_TIMEOUT_SECONDS=1500
# 启动 API 时若 MINERU_BASE_URL 无服务在监听则自动拉起 mineru-api（默认 true；
# Docker 部署或自行管理服务时设为 false）。日志写入 mineru_api.log。
MINERU_AUTO_START=true
# mineru-api 可执行文件路径（mineru_env 虚拟环境）；不存在时回退 PATH 上的 mineru-api
MINERU_EXECUTABLE=D:\my_env\mineru_env\Scripts\mineru-api.exe
# 同时返回 MinerU 版面 JSON，供清洗前重建 H1/H2/H3 层级
MINERU_RETURN_CONTENT_LIST=true
MINERU_RETURN_MIDDLE_JSON=true
HEADING_HIERARCHY_MODE=auto
CHUNK_SIZE_DEFAULT=300
CHUNK_OVERLAP_DEFAULT=40
PARENT_LOOKBACK_DEFAULT=80
MAX_PARENT_SIZE_DEFAULT=2000

# ── Markdown 清洗（转换后、切片前）──────────────────────────────────
# 粗体编号标题仅限独占完整一行才转 ##；过长或包含完整句子的标题降级为正文。
MD_CLEAN_FORCE_SINGLE_H1=false
MD_CLEAN_MAX_HEADING_CHARS=120
MD_CLEAN_ALLOW_INLINE_BOLD_HEADING=false
# 重复同名标题仅当近邻、间隙与后续块都含图片且有效文本很短时才合并。
MD_CLEAN_MERGE_REPEATED_HEADINGS=true
MD_CLEAN_MAX_REPEATED_GAP_LINES=16
MD_CLEAN_MAX_GAP_TEXT_CHARS=20
MD_CLEAN_MAX_REPEATED_BODY_TEXT_CHARS=30
MD_CLEAN_REQUIRE_IMAGE_GAP=true
MD_CLEAN_REQUIRE_IMAGE_BODY=true
# 噪音标题黑名单（逗号分隔）。保存在环境变量配置中，修改后重启 worker 生效。
MD_CLEAN_NOISE_TERMS=THANKS,BUSINESS,CONTENTS,TABLE OF CONTENTS,目录,01,02,03,04,05,06,07,08,09,10
# 基础结构修复（转换后、切片前）：
# 删除 PART 01 / 裸页码；OCR 空格 & sub/sup 残留清理；编号段转列表；
# 长行去重并拆标题；重复正文去重；圆点符号规范化为 -
MD_CLEAN_REMOVE_PAGE_RESIDUE=true
MD_CLEAN_SPLIT_PAGED_LONG_LINES=true
MD_CLEAN_MIN_PAGED_SPLIT_CHARS=100
MD_CLEAN_CONVERT_NUMBERED_BODIES=true
MD_CLEAN_MAX_NUMBERED_LIST_CHARS=360
MD_CLEAN_DEDUPE_REPEATED_TEXT=true
MD_CLEAN_MIN_DUPLICATE_TEXT_CHARS=14
MD_CLEAN_NORMALIZE_OCR_SPACING=true
MD_CLEAN_CLEAN_INLINE_TAGS=true
MD_CLEAN_NORMALIZE_LIST_BULLETS=true
MD_CLEAN_CLEAN_INVISIBLE_CHARS=true
MD_CLEAN_COLLAPSE_WHITESPACE=true
MD_CLEAN_CLEAN_EXTERNAL_LINKS=true
MD_CLEAN_MERGE_SOFT_WRAPS=true
MD_CLEAN_MERGE_BROKEN_SENTENCES=true
MD_CLEAN_MAX_MERGED_LINE_CHARS=600
MD_CLEAN_MIN_BROKEN_MERGE_CHARS=8

# ── MySQL（RAG 父块存储 rag_parent_block）───────────────────────────
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=rag_test
MYSQL_USER=root
MYSQL_PASSWORD=

# ── 安全 ──────────────────────────────────────────────────────────
# CORS 允许来源（逗号分隔），同源前端无需 CORS。
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:8001,http://127.0.0.1:8001
# 启用 API Key：所有上传/删除/入库等 mutating 接口要求 X-API-Key。
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
# 前端需要在页面右上角输入框粘贴同一个 Key（保存在浏览器 localStorage）。
API_KEY=

# ── 任务恢复 ──────────────────────────────────────────────────────
# worker 崩溃后，卡在 converting/chunking/ingesting 超过该秒数的文件
# 会在下次启动时自动重置为可恢复的前序状态。
RECOVER_STALE_SECONDS=3600

# ── Celery worker 自动拉起 ────────────────────────────────────────
# 默认 true：启动 API 时自动用当前 Python 解释器拉起 worker（无需手动开终端）。
# Docker 部署（compose 已有独立 worker 服务）或测试环境请设为 false。
AUTO_START_WORKER=true
